{
  "font": {
    "sans": {
      "$value": "'DM Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    },
    "heading": {
      "$value": "'Montserrat', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "$type": "fontFamily"
    }
  },
  "text": {
    "xs": { "$value": "0.75rem", "$type": "dimension" },
    "sm": { "$value": "0.875rem", "$type": "dimension" },
    "base": { "$value": "1rem", "$type": "dimension" },
    "lg": { "$value": "1.125rem", "$type": "dimension" },
    "xl": { "$value": "clamp(1.25rem, 0.25vw + 1.19rem, 1.5rem)", "$type": "dimension" },
    "2xl": { "$value": "clamp(1.75rem, 0.8vw + 1.5rem, 2.25rem)", "$type": "dimension" },
    "3xl": { "$value": "clamp(2rem, 1.2vw + 1.6rem, 3rem)", "$type": "dimension" },
    "4xl": { "$value": "clamp(2.25rem, 1.8vw + 1.75rem, 3.75rem)", "$type": "dimension" },
    "5xl": { "$value": "clamp(2.5rem, 2.5vw + 1.75rem, 3.75rem)", "$type": "dimension" }
  },
  "leading": {
    "tight": { "$value": "1.15", "$type": "number" },
    "snug": { "$value": "1.35", "$type": "number" },
    "normal": { "$value": "1.6", "$type": "number" }
  },
  "tracking": {
    "tight": { "$value": "-0.02em", "$type": "dimension" },
    "normal": { "$value": "0em", "$type": "dimension" },
    "wide": { "$value": "0.08em", "$type": "dimension" },
    "eyebrow": { "$value": "0.125em", "$type": "dimension" }
  }
}
