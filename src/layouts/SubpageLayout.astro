---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/blocks/PageHero.astro';
import CTABanner from '../components/blocks/CTABanner.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import SubpageAside from '../components/blocks/SubpageAside.astro';
import { bookHref, virtualHref, phoneAction } from '../config/site';
import { getPublished } from '../lib/locations';
import type { BlockAction } from '../components/blocks/types';
import type { BreadcrumbEntry } from '../components/seo/Schema.astro';

interface Props {
  title: string;
  description: string;
  breadcrumbs: BreadcrumbEntry[];
  eyebrow?: string;
  showCtaBanner?: boolean;
}

const {
  title,
  description,
  breadcrumbs,
  eyebrow = 'North Carolina · MyOrthodontist',
  showCtaBanner = true,
} = Astro.props;

const pageActions: BlockAction[] = [
  { icon: 'lucide:calendar', label: 'Book a FREE Consult', href: bookHref },
  { icon: 'lucide:laptop', label: 'Virtual Consult', href: virtualHref, variant: 'outline' },
  { ...phoneAction, variant: 'outline' },
];

const locations = await getPublished();
const offices = locations.map((location) => ({
  name: location.data.name,
  phone: location.data.phone,
  href: `/locations/${location.data.slug ?? location.id}/`,
}));
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <PageHero eyebrow={eyebrow} title={title} body={description} actions={pageActions} />
  <Section background="base" spacing="md">
    <Container gap="lg" class="lg:flex-row lg:items-start">
      <div class="flex min-w-0 w-full flex-col gap-12 lg:w-2/3">
        <slot />
      </div>
      <div class="w-full lg:sticky lg:top-24 lg:w-1/3 lg:self-start">
        <SubpageAside offices={offices} />
      </div>
    </Container>
  </Section>
  {
    showCtaBanner && (
      <CTABanner
        background="inverse"
        title="Ready for your free consultation?"
        body="Schedule in minutes — virtual or in-office."
        actions={pageActions}
      />
    )
  }
</BaseLayout>
