---
import type { HTMLAttributes } from 'astro/types';

export type ButtonVariant =
  'primary' | 'secondary' | 'outline' | 'ghost' | 'inverse' | 'ghost-white';
export type ButtonSize = 'sm' | 'md' | 'lg';

type Props = {
  variant?: ButtonVariant;
  size?: ButtonSize;
  href?: string;
  class?: string;
} & Omit<HTMLAttributes<'a'>, 'class'> &
  Omit<HTMLAttributes<'button'>, 'class'>;

const { variant = 'primary', size = 'md', href, class: className, ...rest } = Astro.props;

const Tag = href ? 'a' : 'button';

const variants: Record<ButtonVariant, string> = {
  primary:
    'border-transparent bg-[linear-gradient(180deg,var(--color-accent-400)_0%,var(--color-accent-600)_100%)] text-white hover:brightness-105',
  secondary: 'border-white bg-transparent text-white hover:bg-white hover:text-brand-600',
  outline: 'border-brand-600 bg-transparent text-brand-600 hover:bg-brand-600 hover:text-white',
  ghost: 'border-transparent bg-transparent text-ink-base hover:bg-neutral-100',
  inverse: 'border-transparent bg-white text-brand-600 hover:bg-neutral-100',
  'ghost-white': 'border-transparent bg-transparent text-white hover:bg-white/10',
};

// min-h keeps every size above the 44px touch target on small screens.
const sizes: Record<ButtonSize, string> = {
  sm: 'min-h-11 px-5 text-xs',
  md: 'min-h-12 px-6 text-sm',
  lg: 'min-h-14 px-8 text-base',
};
---

<Tag
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-xl border font-sans font-semibold tracking-wide uppercase',
    'no-underline transition-[filter,background-color,color] duration-300',
    'disabled:pointer-events-none disabled:opacity-50',
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
