---
import type { HTMLAttributes } from 'astro/types';

export type ButtonVariant = 'primary' | 'secondary' | 'ghost' | 'inverse' | 'ghost-white';
export type ButtonSize = 'sm' | 'md' | 'lg';

type Props = {
  variant?: ButtonVariant;
  size?: ButtonSize;
  href?: string;
  class?: string;
} & Omit<HTMLAttributes<'a'>, 'class'> &
  Omit<HTMLAttributes<'button'>, 'class'>;

const { variant = 'primary', size = 'md', href, class: className, ...rest } = Astro.props;

const Tag = href ? 'a' : 'button';

const variants: Record<ButtonVariant, string> = {
  primary: 'bg-accent-500 text-white hover:bg-accent-600 border-transparent',
  secondary: 'bg-transparent text-white border-white hover:bg-white hover:text-accent-500',
  ghost: 'bg-transparent text-ink-base border-transparent hover:bg-white',
  inverse: 'bg-neutral-0 text-ink-brand border-transparent hover:bg-brand-50',
  'ghost-white': 'bg-transparent text-white border-transparent hover:bg-brand-500',
};

// min-h keeps every size above the 44px touch target on small screens.
const sizes: Record<ButtonSize, string> = {
  sm: 'min-h-11 px-4 text-sm',
  md: 'min-h-12 px-6 text-base',
  lg: 'min-h-14 px-8 text-lg',
};
---

<Tag
  href={href}
  class:list={[
    'inline-flex items-center uppercase font-medium justify-center gap-2 rounded-4xl border tracking-wide font-sans',
    'no-underline transition-colors duration-300',
    'disabled:pointer-events-none disabled:opacity-50',
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
