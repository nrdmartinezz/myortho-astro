---
import type { HTMLAttributes } from 'astro/types';

export type CardVariant = 'plain' | 'outlined' | 'elevated';

interface Props extends Omit<HTMLAttributes<'div'>, 'class'> {
  as?: 'div' | 'article' | 'li';
  variant?: CardVariant;
  padded?: boolean;
  class?: string;
}

const {
  as: Tag = 'div',
  variant = 'outlined',
  padded = true,
  class: className,
  ...rest
} = Astro.props;

const variants: Record<CardVariant, string> = {
  plain: 'bg-transparent',
  outlined: 'border-line-base bg-surface-base border',
  elevated: 'bg-surface-base shadow-md',
};
---

<Tag
  class:list={['flex flex-col rounded-2xl', variants[variant], padded && 'gap-3 p-6', className]}
  {...rest}
>
  <slot />
</Tag>
