---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import { navigation } from '../../config/navigation';
import { site } from '../../config/site';
import { getPublished } from '../../lib/locations';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import logo from '../../images/myorthodontist-logo.png';

const socialIcons: Record<string, string> = {
  facebook: 'lucide:facebook',
  instagram: 'lucide:instagram',
  linkedin: 'lucide:linkedin',
  x: 'lucide:twitter',
  youtube: 'lucide:youtube',
  tiktok: 'lucide:music',
};

const socials = Object.entries(site.social).filter(([, href]) => Boolean(href)) as [
  string,
  string,
][];
const year = new Date().getFullYear();

const locationOrder = [
  'cary',
  'raleigh',
  'chapel-hill',
  'sanford',
  'wake-forest',
  'concord',
  'roanoke-rapids',
  'fayetteville',
  'durham',
  'mount-airy',
  'burgaw',
  'washington',
  'greensboro',
  'rocky-mount',
];

const locations = await getPublished();
const orderedLocations = [
  ...locationOrder.flatMap((id) => {
    const match = locations.find((entry) => entry.id === id);
    return match ? [match] : [];
  }),
  ...locations.filter((entry) => !locationOrder.includes(entry.id)),
];
const midpoint = Math.ceil(orderedLocations.length / 2);
const locationColumns = [orderedLocations.slice(0, midpoint), orderedLocations.slice(midpoint)];

const quickLinks =
  navigation.footer.find((group) => group.heading === 'Quick Links') ?? navigation.footer[0];

const about =
  'MyOrthodontist is a family-oriented practice whose priority is delivering exceptional and affordable orthodontic treatment in a warm and welcoming environment across North Carolina.';
---

<Section as="footer" background="inverse" spacing="md">
  <Container gap="lg">
    <div class="grid w-full gap-10 md:grid-cols-2 lg:grid-cols-[1.15fr_0.85fr_1.15fr] lg:gap-16">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-flex w-fit no-underline">
          <Image src={logo} alt={site.name} class="h-auto w-48" />
        </a>
        <p class="max-w-reading text-sm leading-relaxed text-neutral-300">{about}</p>

        <address class="flex flex-col gap-2 not-italic">
          <a
            href={`tel:${site.business.phoneHref}`}
            class="text-ink-inverse inline-flex min-h-11 items-center gap-3 no-underline"
          >
            <span
              class="bg-accent-700 inline-flex size-9 shrink-0 items-center justify-center rounded-md"
              aria-hidden="true"
            >
              <Icon name="lucide:phone" class="size-4" />
            </span>
            {site.business.phone}
          </a>
          <a
            href="/locations/"
            class="text-ink-inverse inline-flex min-h-11 items-center gap-3 no-underline"
          >
            <span
              class="bg-accent-700 inline-flex size-9 shrink-0 items-center justify-center rounded-md"
              aria-hidden="true"
            >
              <Icon name="lucide:map-pin" class="size-4" />
            </span>
            {locations.length} Locations Across NC
          </a>
        </address>

        {
          socials.length > 0 && (
            <ul class="flex gap-2">
              {socials.map(([platform, href]) => (
                <li>
                  <a
                    href={href}
                    rel="noopener noreferrer"
                    target="_blank"
                    class="inline-flex size-11 items-center justify-center rounded-md bg-brand-800 text-neutral-300 no-underline hover:bg-brand-700 hover:text-ink-inverse"
                  >
                    <span class="sr-only">{platform}</span>
                    <Icon
                      name={socialIcons[platform] ?? 'lucide:link'}
                      class="size-5"
                      aria-hidden="true"
                    />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        quickLinks && (
          <nav aria-label={quickLinks.heading} class="flex flex-col gap-3">
            <h2 class="text-ink-inverse text-sm font-semibold tracking-wide uppercase">
              {quickLinks.heading}
            </h2>
            <ul class="flex flex-col">
              {quickLinks.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="hover:text-ink-inverse inline-flex min-h-11 items-center text-neutral-300 no-underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <div class="flex flex-col gap-6">
        <nav aria-label="Our locations" class="flex flex-col gap-3">
          <h2 class="text-ink-inverse text-sm font-semibold tracking-wide uppercase">
            Our Locations
          </h2>
          <div class="grid grid-cols-2 gap-x-6">
            {
              locationColumns.map((column) => (
                <ul class="flex flex-col">
                  {column.map((location) => (
                    <li>
                      <a
                        href={`/locations/${location.data.slug ?? location.id}/`}
                        class="hover:text-ink-inverse inline-flex min-h-11 items-center gap-2 text-neutral-300 no-underline"
                      >
                        <span
                          class="bg-accent-500 size-1.5 shrink-0 rounded-full"
                          aria-hidden="true"
                        />
                        {location.data.name}
                      </a>
                    </li>
                  ))}
                </ul>
              ))
            }
          </div>
        </nav>

        <div class="rounded-lg border border-white/15 bg-brand-800/50 p-4">
          <p
            class="bg-accent-500 text-brand-800 inline-flex rounded-full px-2.5 py-0.5 text-[0.65rem] font-semibold tracking-wide uppercase"
          >
            Award
          </p>
          <p class="text-ink-inverse mt-2 font-semibold">Triangle Business Journal</p>
          <p class="text-sm text-neutral-400">Leaders in Diversity — 2024</p>
        </div>
      </div>
    </div>

    <div
      class="flex w-full flex-col gap-3 border-t border-white/10 pt-6 text-sm text-neutral-400 md:flex-row md:items-center md:justify-between"
    >
      <p>
        &copy; {year} MyOrthodontist | Orthodontic Consultants New Patient Group
      </p>
      <ul class="flex flex-wrap gap-6">
        {
          navigation.legal.map((link) => (
            <li>
              <a href={link.href} class="hover:text-ink-inverse text-neutral-400 no-underline">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</Section>
