---
/**
 * Owns its outer element rather than wrapping in Section: sticky behaviour
 * needs its own positioning and stacking context. Container is used inside.
 *
 * The nav slots are filled by MegaMenu (md and up) and MobileNav (below md),
 * both reading src/config/navigation.ts — one tree, two renderings.
 */
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import MegaMenu from './MegaMenu.astro';
import MobileNav from './MobileNav.astro';
import { navigation } from '../../config/navigation';
import { site } from '../../config/site';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import logo from '../../images/myorthodontist-logo.png';

export type HeaderSticky = 'static' | 'sticky' | 'shrink' | 'hide-on-scroll';

interface Props {
  sticky?: HeaderSticky;
}

const { sticky = 'sticky' } = Astro.props;

const currentPath = Astro.url.pathname;
const positioned = sticky !== 'static';
---
<div class="utility">
  <div class="container">
    <span class="utility-message text-xs text-neutral-300 font-medium">
      {site.tagline}
    </span>
    <div class="utility-links">

      <div class="icon-links"
      ><a href="/locations/">
        <Icon name="lucide:map-pin" class="size-4" aria-hidden="true" />Find a Location
      </a>
      <a  href={`tel:${site.business.phoneHref}`}> 
        <Icon name="lucide:phone" class="size-4" aria-hidden="true" />1-800-MY-ORTHO
      </a>
    </div>
      {
        navigation.cta && (
          <Button href={navigation.cta.href} size="sm" class="font-bold max-md:hidden">
            Schedule Today
          </Button>
        )
      }
    </div>
  </div>
</div>
<header
  data-sticky={sticky}
  class:list={[
    'group/header border-line-base bg-surface-base z-50 w-full border-b',
    // The mega panel is absolutely positioned against the header, so the header
    // must be a positioned ancestor even when it isn't sticky.
    positioned ? 'sticky top-0' : 'relative',
  ]}
>
  <Container
    as="div"
    layout="bar"
    gap="none"
    class="justify-between gap-4 py-4 group-data-[scrolled=true]/header:py-2"
  >
    <a href="/" class="text-ink-base flex items-center gap-2 font-semibold no-underline">
      <Image src={logo} alt={site.name} class="h-auto w-40" loading="eager" />
    </a>

    <MegaMenu currentPath={currentPath} />

    <div class="flex items-center gap-2">
      <a
        href={`tel:${site.business.phoneHref}`}
        class="text-brand-800 hidden min-h-11 items-center gap-2 px-2 font-medium no-underline lg:inline-flex text-xs"
      >
        <Icon name="lucide:phone" class="size-4" aria-hidden="true" />
        {site.business.phone}
      </a>

      {
        navigation.cta && (
          <Button href={navigation.cta.href} size="sm" class="max-md:hidden text-xs">
            {navigation.cta.label}
          </Button>
        )
      }

      <MobileNav currentPath={currentPath} />
    </div>
  </Container>
</header>

<style>
  header {
    transition:
      transform 200ms ease,
      padding 150ms ease;
  }

  .utility {
    background-color: var(--color-brand-700);
    border-bottom: 1px solid var(--color-line-base);
    padding: 8px 0;
    justify-content: center;
    align-items: center;
    .container{
      display:flex;
      flex-direction:row;
      justify-content:space-between;
      justify-self:center;
    }
  }

  .utility-message {
    margin:auto 0;
  }
  
  .utility-links {
    display: flex;
    align-items: center;
    .icon-links {
      display:flex;
      flex-direction:row;
      color:var(--color-neutral-300);
    }
  }

  .utility-links a {
    margin-left: 1rem;
    text-decoration: none;
    width: fit-content;
   display: flex;
    align-items: center;
    gap:9px;
    font-size: var(--text-xs);
  }

  header[data-hidden='true'] {
    transform: translateY(-100%);
  }

  header[data-scrolled='true'] {
    box-shadow: var(--shadow-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    header {
      transition: none;
    }

    header[data-hidden='true'] {
      transform: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('header[data-sticky]');

  if (header) {
    const mode = header.dataset.sticky;

    if (mode === 'shrink' || mode === 'hide-on-scroll') {
      let lastY = window.scrollY;
      let ticking = false;

      const update = () => {
        const y = window.scrollY;
        header.dataset.scrolled = String(y > 8);

        if (mode === 'hide-on-scroll') {
          // Never retract while the drawer or a mega panel is open.
          const navOpen =
            document.querySelector('#nav-toggle')?.getAttribute('aria-expanded') === 'true' ||
            document.querySelector('.mega-item[data-open="true"]') !== null;
          header.dataset.hidden = String(!navOpen && y > lastY && y > 120);
        }

        lastY = y;
        ticking = false;
      };

      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true },
      );

      update();
    }
  }
</script>
