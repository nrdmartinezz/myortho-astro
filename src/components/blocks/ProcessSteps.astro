---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Heading from '../ui/Heading.astro';
import BlockHeader from './BlockHeader.astro';
import { Icon } from 'astro-icon/components';
import type { BlockProps } from './types';

export interface ProcessStep {
  title: string;
  body: string;
  icon?: string;
}

interface Props extends BlockProps {
  items: ProcessStep[];
  /** Numbers the steps rather than showing icons. */
  numbered?: boolean;
  columns?: 2 | 3 | 4;
}

const {
  background = 'base',
  spacing = 'md',
  align = 'start',
  width = 'page',
  eyebrow,
  title,
  body,
  titleLevel = 2,
  items,
  numbered = true,
  columns = 4,
  bare = false,
} = Astro.props;

const columnClass = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
}[columns];
---

<Section as={bare ? 'div' : 'section'} background={background} spacing={bare ? 'none' : spacing}>
  <Container width={width} align={align} gap="lg" class:list={[bare && 'mx-0! max-w-none! px-0!']}>
    <BlockHeader eyebrow={eyebrow} title={title} body={body} level={titleLevel} />

    <ol class:list={['grid w-full gap-8', columnClass]}>
      {
        items.map((step, index) => (
          <li class="flex flex-col gap-3">
            <span
              class="bg-brand-600 text-neutral-0 flex size-11 items-center justify-center rounded-full font-semibold"
              aria-hidden="true"
            >
              {numbered || !step.icon ? index + 1 : <Icon name={step.icon} class="size-5" />}
            </span>
            <Heading level={titleLevel === 2 ? 3 : 4} size="md">
              {step.title}
            </Heading>
            <p class="text-ink-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </Container>
</Section>
