---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Heading from '../ui/Heading.astro';
import ActionButton from './ActionButton.astro';
import { Icon } from 'astro-icon/components';
import type { BlockProps, BlockAction } from './types';

interface Props extends BlockProps {
  image?: ImageMetadata;
  imageAlt?: string;
  bullets?: string[];
  actions?: BlockAction[];
  /** Media (image or `media` slot) sits on the right on desktop by default; small screens always stack media-first. */
  reverse?: boolean;
}

const {
  background = 'base',
  spacing = 'md',
  width = 'page',
  eyebrow,
  title,
  body,
  titleLevel = 2,
  image,
  imageAlt = '',
  bullets = [],
  actions = [],
  reverse = false,
} = Astro.props;

const hasMediaSlot = Astro.slots.has('media');

const BULLETS_PER_COLUMN = 5;
const COLUMNS_PER_ROW = 3;

function chunk<T>(items: T[], size: number): T[][] {
  const chunks: T[][] = [];
  for (let i = 0; i < items.length; i += size) {
    chunks.push(items.slice(i, i + size));
  }
  return chunks;
}

const bulletRows = chunk(chunk(bullets, BULLETS_PER_COLUMN), COLUMNS_PER_ROW);
---

<Section background={background} spacing={spacing}>
  <Container width={width} layout="row" gap="lg">
    <div class:list={['w-full md:w-1/2', reverse ? 'md:order-2' : 'md:order-1']}>
      {
        hasMediaSlot ? (
          <slot name="media" />
        ) : image ? (
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 768, 1024]}
            sizes="(max-width: 768px) 100vw, 50vw"
            loading="lazy"
            class="w-full rounded-lg object-cover"
          />
        ) : (
          <div class="bg-surface-muted aspect-4/3 w-full rounded-lg" aria-hidden="true" />
        )
      }
    </div>

    <div
      class:list={[
        'flex flex-col items-start gap-5 md:w-1/2',
        reverse ? 'md:order-1' : 'md:order-2',
      ]}
    >
      {
        eyebrow && (
          <p class="block-eyebrow tracking-eyebrow text-xs font-semibold uppercase">
            {eyebrow}
          </p>
        )
      }
      {title && <Heading level={titleLevel} set:html={title} />}
      {body && <p class="text-ink-muted max-w-reading">{body}</p>}

      {
        bullets.length > 0 && (
          <div class="flex w-full flex-col gap-6">
            {bulletRows.map((row) => (
              <div class="flex w-full gap-6 max-md:flex-col">
                {row.map((column) => (
                  <ul class="flex min-w-0 flex-1 flex-col gap-2">
                    {column.map((bullet) => (
                      <li class="flex items-start gap-3">
                        <Icon
                          name="lucide:circle-check"
                          class="text-accent-500 mt-1 size-5 shrink-0"
                          aria-hidden="true"
                        />
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                ))}
              </div>
            ))}
          </div>
        )
      }

      {
        actions.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {actions.map((action) => (
              <ActionButton action={action} size="lg" defaultVariant="primary" />
            ))}
          </div>
        )
      }
    </div>
  </Container>
</Section>
