---
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';

export interface OfficeItem {
  name: string;
  phone: string;
  href: string;
}

interface Props {
  offices: OfficeItem[];
  title?: string;
  /** Conversion `data-source` on each Call button. */
  source?: string;
}

const { offices, title = 'Our locations', source = 'office-list' } = Astro.props;

const telHref = (value: string) => {
  const digits = value.replace(/\D/g, '');
  return `tel:+${digits.length === 10 ? `1${digits}` : digits}`;
};
---

{
  offices.length > 0 && (
    <Card class="w-full" variant="outlined" hover={false}>
      <p class="font-semibold">{title}</p>
      <div class="max-h-80 w-full overflow-y-auto overscroll-contain pe-3">
        <ul>
          {offices.map((office) => (
            <li class="border-line-base flex items-center gap-3 border-b px-3 py-3 transition-colors last:border-b-0 hover:bg-neutral-100">
              <a
                href={office.href}
                class="text-ink-base flex min-h-11 min-w-0 flex-1 flex-col justify-center no-underline"
              >
                <span class="font-medium">{office.name}</span>
                <span class="text-ink-muted text-sm">{office.phone}</span>
              </a>
              <Button
                href={telHref(office.phone)}
                size="sm"
                variant="outline"
                data-source={source}
                aria-label={`Call ${office.name}`}
              >
                Call
              </Button>
            </li>
          ))}
        </ul>
      </div>
    </Card>
  )
}
