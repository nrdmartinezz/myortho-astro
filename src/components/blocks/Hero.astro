---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Heading from '../ui/Heading.astro';
import ActionButton from './ActionButton.astro';
import PillButton from './PillButton.astro';
import { Icon } from 'astro-icon/components';
import type { BlockProps, BlockAction } from './types';

interface Props extends Omit<BlockProps, 'titleLevel'> {
  title: string;
  actions?: BlockAction[];
  image?: ImageMetadata;
  imageAlt?: string;
  /** Places the image first on desktop; small screens always stack image-first. */
  reverse?: boolean;
  bullets?: string[];
  backgroundImage?: ImageMetadata;
  backgroundImageAlt?: string;
  /** Dark scrim over the background image so text stays readable; pass false to disable. */
  overlay?: boolean;
  pills?: HeroPill[];
}

interface HeroPill {
  label: string;
  href: string;
  icon?: string;
}

const {
  background = 'muted',
  spacing = 'lg',
  align = 'start',
  width = 'page',
  eyebrow,
  title,
  body,
  actions = [],
  image,
  imageAlt = '',
  reverse = false,
  bullets = [],
  backgroundImage,
  backgroundImageAlt = '',
  overlay = true,
  pills = [],
} = Astro.props;

const isInverse = background === 'inverse' || background === 'brand';

// Chunked (not wrapped) so the row count stays fixed at 3 regardless of pill widths.
const pillChunkSize = Math.ceil(pills.length / 3);
const pillRows: HeroPill[][] = [
  pills.slice(0, pillChunkSize),
  pills.slice(pillChunkSize, pillChunkSize * 2),
  pills.slice(pillChunkSize * 2),
].filter((row) => row.length > 0);
---

<Section
  background={background}
  spacing={spacing}
  clip={Boolean(backgroundImage)}
  class={backgroundImage ? 'relative isolate' : undefined}
>
  {
    backgroundImage && (
      <>
        <Image
          src={backgroundImage}
          alt={backgroundImageAlt}
          widths={[640, 1024, 1600, 2048]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 -z-10 h-full w-full object-cover"
        />
        {overlay && (
          <div
            class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgb(0_42_78/0.98)_8%,rgb(10_77_133/0.43)_100%)]"
            aria-hidden="true"
          />
        )}
      </>
    )
  }
  <Container width={width} layout={image ? 'row' : 'stack'} align={align} gap="lg">
    <div
      class:list={['flex flex-col items-start gap-6', image && 'md:w-1/2', reverse && 'md:order-2']}
    >
      {
        eyebrow && (
          <p
            class:list={[
              'block-eyebrow tracking-eyebrow text-xs font-light uppercase',
              isInverse ? 'text-accent-300' : 'text-ink-subtle',
            ]}
          >
            {eyebrow}
          </p>
        )
      }

      <Heading class="text-ink-inverse font-bold" level={1} set:html={title} />

      {body && <p class="max-w-reading text-sm text-white/70">{body}</p>}

      {
        bullets.length > 0 && (
          <ul class="flex flex-col gap-2">
            {bullets.map((bullet) => (
              <li class="flex items-start gap-3">
                <Icon
                  name="lucide:check"
                  class="mt-1 size-5 shrink-0 opacity-80"
                  aria-hidden="true"
                />
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        )
      }
      {
        pills?.length > 0 && (
          <div class="flex flex-col gap-2">
            {pillRows.map((row) => (
              <ul class="flex gap-2">
                {row.map((pill) => (
                  <li>
                    <PillButton
                      label={pill.label}
                      href={pill.href}
                      icon={pill.icon}
                      inverse={isInverse}
                    />
                  </li>
                ))}
              </ul>
            ))}
          </div>
        )
      }

      {
        actions.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {actions.map((action) => (
              <ActionButton action={action} size="md" />
            ))}
          </div>
        )
      }
    </div>

    {
      image && (
        <div class:list={['w-full md:w-1/2', reverse && 'md:order-1']}>
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 768, 1024]}
            sizes="(max-width: 768px) 100vw, 50vw"
            loading="eager"
            fetchpriority="high"
            class="w-full rounded-lg object-cover"
          />
        </div>
      )
    }
  </Container>
</Section>
