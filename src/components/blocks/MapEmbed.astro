---
/**
 * Facade pattern: renders a static placeholder and loads the Google Maps iframe
 * once the placeholder is near the viewport. An eager map iframe costs ~700KB
 * and several hundred ms of main-thread time on every page it appears.
 */
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import BlockHeader from './BlockHeader.astro';
import { Icon } from 'astro-icon/components';
import { site, formattedAddress } from '../../config/site';
import type { BlockProps } from './types';

interface Props extends BlockProps {
  /** Defaults to the address in site.ts. */
  query?: string;
  zoom?: number;
  height?: string;
  /** Display phone for the Call link; defaults to the practice 800 number. */
  phone?: string;
}

const {
  background = 'base',
  spacing = 'md',
  align = 'start',
  width = 'page',
  eyebrow,
  title,
  body,
  titleLevel = 2,
  query = formattedAddress,
  zoom = 15,
  height = '420px',
  bare = false,
  phone,
} = Astro.props;

const embedSrc = `https://maps.google.com/maps?q=${encodeURIComponent(query)}&z=${zoom}&output=embed`;
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(query)}`;

const telHref = (value: string) => {
  const digits = value.replace(/\D/g, '');
  return `tel:+${digits.length === 10 ? `1${digits}` : digits}`;
};

const callLabel = phone ?? site.business.phone;
const callHref = phone ? telHref(phone) : `tel:${site.business.phoneHref}`;
---

<Section
  as={bare ? 'div' : 'section'}
  background={background}
  spacing={bare ? 'none' : spacing}
  class={bare ? 'flex h-full min-h-80 flex-col' : undefined}
>
  <Container
    width={width}
    align={align}
    gap="lg"
    class:list={[bare && 'mx-0! h-full max-w-none! flex-1 px-0!']}
  >
    <BlockHeader eyebrow={eyebrow} title={title} body={body} level={titleLevel} />

    <div
      class:list={[
        'map-facade border-line-base bg-surface-muted relative w-full overflow-hidden rounded-lg border',
        bare && 'min-h-80 flex-1',
      ]}
      style={bare ? undefined : `height:${height}`}
      data-src={embedSrc}
    >
      <div
        class="text-ink-base absolute inset-0 flex flex-col items-center justify-center gap-3 p-6 text-center"
      >
        <Icon name="lucide:map-pin" class="text-brand-600 size-10" aria-hidden="true" />
        <span class="text-ink-muted max-w-reading text-sm">{query}</span>
      </div>
    </div>

    {
      !bare && (
        <div class="flex flex-wrap gap-4 text-sm">
          <a href={directionsHref} rel="noopener noreferrer" target="_blank" class="text-ink-brand">
            Get directions
          </a>
          <a href={callHref} class="text-ink-brand">
            Call {callLabel}
          </a>
        </div>
      )
    }
  </Container>
</Section>

<script>
  const facades = document.querySelectorAll<HTMLElement>('.map-facade');

  const load = (facade: HTMLElement) => {
    if (facade.querySelector('iframe')) return;
    const iframe = document.createElement('iframe');
    iframe.src = facade.dataset.src ?? '';
    iframe.title = 'Location map';
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    iframe.className = 'absolute inset-0 h-full w-full border-0';
    facade.replaceChildren(iframe);
  };

  if (!('IntersectionObserver' in window)) {
    facades.forEach(load);
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const facade = entry.target as HTMLElement;
          load(facade);
          observer.unobserve(facade);
        }
      },
      { rootMargin: '200px' },
    );
    facades.forEach((facade) => observer.observe(facade));
  }
</script>
