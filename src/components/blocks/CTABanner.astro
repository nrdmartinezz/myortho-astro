---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Heading from '../ui/Heading.astro';
import ActionButton from './ActionButton.astro';
import type { BlockProps, BlockAction } from './types';

interface Props extends BlockProps {
  actions: BlockAction[];
  backgroundImage?: ImageMetadata;
  backgroundImageAlt?: string;
}

const {
  background = 'inverse',
  spacing = 'md',
  align = 'center',
  width = 'narrow',
  eyebrow,
  title,
  body,
  titleLevel = 2,
  actions,
  backgroundImage,
  backgroundImageAlt = '',
} = Astro.props;

const defaultVariant =
  background === 'brand' ||
  background === 'inverse' ||
  background === 'gradient' ||
  background === 'accent'
    ? 'inverse'
    : 'primary';
---

<Section
  background={background}
  spacing={spacing}
  clip={Boolean(backgroundImage)}
  class={backgroundImage ? 'relative isolate' : undefined}
>
  {
    backgroundImage && (
      <>
        <Image
          src={backgroundImage}
          alt={backgroundImageAlt}
          widths={[640, 1024, 1600]}
          sizes="100vw"
          loading="lazy"
          class="absolute inset-0 -z-10 h-full w-full object-cover"
        />
        <div
          class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgb(0_28_52/0.95)_0%,rgb(0_59_106/0.75)_100%)]"
          aria-hidden="true"
        />
      </>
    )
  }
  <Container width={width} align={align} gap="md">
    {
      eyebrow && (
        <p class="block-eyebrow tracking-eyebrow text-xs font-light uppercase">
          {eyebrow}
        </p>
      )
    }
    {title && <Heading level={titleLevel} set:html={title} />}
    {body && <p class="block-body max-w-reading text-lg">{body}</p>}

    <div class:list={['flex flex-wrap gap-3', align === 'center' && 'justify-center']}>
      {
        actions.map((action) => (
          <ActionButton action={action} size="lg" defaultVariant={defaultVariant} />
        ))
      }
    </div>
  </Container>
</Section>
