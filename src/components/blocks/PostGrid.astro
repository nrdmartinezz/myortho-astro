---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Card from '../ui/Card.astro';
import Heading from '../ui/Heading.astro';
import BlockHeader from './BlockHeader.astro';
import { Icon } from 'astro-icon/components';
import type { BlockAction, BlockProps } from './types';

export interface PostItem {
  title: string;
  body: string;
  href: string;
  date: string;
  dateTime?: string;
  tag?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  ctaLabel?: string;
}

interface Props extends BlockProps {
  items: PostItem[];
  columns?: 2 | 3;
  action?: BlockAction;
}

const {
  background = 'base',
  spacing = 'md',
  align = 'start',
  width = 'page',
  eyebrow,
  title,
  body,
  titleLevel = 2,
  headerLayout = 'split',
  items,
  columns = 3,
  action,
} = Astro.props;

const columnClass = { 2: 'md:grid-cols-2', 3: 'md:grid-cols-3' }[columns];
---

<Section background={background} spacing={spacing}>
  <Container width={width} align={align} gap="lg" class="[&_.block-eyebrow]:text-accent-500">
    <BlockHeader
      eyebrow={eyebrow}
      title={title}
      body={body}
      level={titleLevel}
      layout={headerLayout}
      centered={align === 'center'}
      action={action}
    />

    <ul class:list={['grid w-full gap-8', columnClass]}>
      {
        items.map((item) => (
          <Card as="li" variant="elevated" padded={false}>
            {item.image && (
              <div class="relative w-full">
                <Image
                  src={item.image}
                  alt={item.imageAlt ?? ''}
                  widths={[320, 480, 640]}
                  sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                  loading="lazy"
                  class="aspect-16/10 w-full object-cover"
                />
                {item.tag && (
                  <span class="bg-accent-500 absolute top-3 left-3 rounded-full px-3 py-1 text-xs font-semibold text-white">
                    {item.tag}
                  </span>
                )}
              </div>
            )}

            <div class="flex flex-1 flex-col gap-3 p-6">
              {item.date && (
                <p class="text-ink-muted flex items-center gap-1.5 text-sm">
                  <Icon name="lucide:calendar" class="size-3.5 shrink-0" aria-hidden="true" />
                  <time datetime={item.dateTime}>{item.date}</time>
                </p>
              )}

              <Heading level={titleLevel === 2 ? 3 : 4} size="md">
                {item.title}
              </Heading>

              <p class="text-ink-muted text-sm">{item.body}</p>

              <a
                href={item.href}
                class="mt-auto inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold no-underline"
                data-slot="cta"
              >
                {item.ctaLabel ?? 'Read Article'}
                <Icon name="lucide:arrow-right" class="size-3.5" aria-hidden="true" />
              </a>
            </div>
          </Card>
        ))
      }
    </ul>
  </Container>
</Section>
