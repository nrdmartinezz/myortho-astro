---
/** Shared heading cluster so every block introduces itself the same way. */
import Heading from '../ui/Heading.astro';
import { Icon } from 'astro-icon/components';
import type { BlockAction } from './types';

export type BlockHeaderLayout = 'stack' | 'split';

interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  level?: 2 | 3;
  centered?: boolean;
  /** `split` places eyebrow+title on the start edge and body/action on the end. */
  layout?: BlockHeaderLayout;
  action?: BlockAction;
}

const { eyebrow, title, body, level = 2, centered = true, layout, action } = Astro.props;

const split = layout === 'split' && Boolean(body || action) && Boolean(eyebrow || title);
---

{
  (eyebrow || title || body || action) && (
    <div
      class:list={[
        'flex w-full',
        split
          ? 'flex-row items-end justify-between gap-8 max-md:flex-col max-md:items-start max-md:gap-4 max-md:text-start'
          : ['flex-col gap-3', centered && 'items-center text-center'],
      ]}
    >
      {(eyebrow || title) && (
        <div class:list={['flex flex-col gap-3', split && 'min-w-0 flex-1 text-start']}>
          {eyebrow && (
            <p class="block-eyebrow tracking-eyebrow text-xs font-semibold uppercase">{eyebrow}</p>
          )}
          {title && <Heading level={level} set:html={title} />}
        </div>
      )}
      {(body || action) && (
        <div
          class:list={[
            'flex flex-col gap-2',
            split && 'items-end max-md:items-start',
            split && body && 'md:max-w-reading min-w-0 flex-1',
            split && !body && 'shrink-0',
            !split && centered && 'items-center',
          ]}
        >
          {body && (
            <p
              class:list={[
                'block-body text-base',
                split
                  ? 'md:max-w-reading min-w-0 text-end max-md:text-start md:pt-1'
                  : 'max-w-reading',
              ]}
            >
              {body}
            </p>
          )}
          {action && (
            <a
              href={action.href}
              class="text-accent-500 tracking-eyebrow inline-flex items-center gap-1.5 text-xs font-semibold uppercase no-underline"
            >
              {action.label}
              <Icon
                name={action.icon ?? 'lucide:arrow-right'}
                class="size-3.5"
                aria-hidden="true"
              />
            </a>
          )}
        </div>
      )}
    </div>
  )
}
