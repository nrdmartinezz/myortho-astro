---
/** Shared heading cluster so every block introduces itself the same way. */
import Heading from '../ui/Heading.astro';

export type BlockHeaderLayout = 'stack' | 'split';

interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  level?: 2 | 3;
  centered?: boolean;
  /** `split` places eyebrow+title on the start edge and body on the end. */
  layout?: BlockHeaderLayout;
}

const { eyebrow, title, body, level = 2, centered = true, layout } = Astro.props;

const split = layout === 'split' && Boolean(body) && Boolean(eyebrow || title);
---

{
  (eyebrow || title || body) && (
    <div
      class:list={[
        'flex w-full',
        split
          ? 'flex-row items-end justify-between gap-8 max-md:flex-col max-md:gap-4'
          : ['flex-col gap-3', centered && 'items-center text-center'],
      ]}
    >
      {
        (eyebrow || title) && (
          <div class:list={['flex flex-col gap-3', split && 'min-w-0 flex-1 text-start']}>
            {eyebrow && (
              <p class="block-eyebrow tracking-eyebrow text-xs font-semibold uppercase">
                {eyebrow}
              </p>
            )}
            {title && <Heading level={level} set:html={title} />}
          </div>
        )
      }
      {body && (
        <p
          class:list={[
            'block-body text-base',
            split ? 'min-w-0 flex-1 text-end max-md:text-start md:max-w-reading md:pt-1' : 'max-w-reading',
          ]}
        >
          {body}
        </p>
      )}
    </div>
  )
}
