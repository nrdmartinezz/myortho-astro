---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import BlockHeader from './BlockHeader.astro';
import type { BlockProps } from './types';

export interface Stat {
  value: string;
  label: string;
}

interface Props extends BlockProps {
  items: Stat[];
}

const {
  background = 'base',
  spacing = 'md',
  align = 'start',
  width = 'page',
  eyebrow,
  title,
  body,
  titleLevel = 2,
  items,
} = Astro.props;

const columnClass = items.length === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-3';
const compact = !eyebrow && !title && !body;
---

<Section background={background} spacing={compact ? 'sm' : spacing}>
  <Container width={width} align={align} gap="lg">
    <BlockHeader eyebrow={eyebrow} title={title} body={body} level={titleLevel} />

    <dl class:list={['grid w-full gap-8', columnClass]}>
      {
        items.map((stat) => (
          <div class="font-heading flex flex-col gap-1 text-center">
            <dd
              class="stat-value text-3xl tracking-tight text-white md:text-4xl"
              set:html={stat.value}
            />
            <dt class="stat-label text-sm font-extrabold text-[rgba(255,255,255,0.83)]">
              {stat.label}
            </dt>
          </div>
        ))
      }
    </dl>
  </Container>
</Section>

<style>
  .stat-value {
    color: #ffffff80;
    font-weight: 700;
  }

  .stat-label {
    font-weight: 400;
  }

  /* set:html injects <em>; scoped selectors never match those nodes. */
  .stat-value :global(em),
  .stat-label :global(em) {
    color: var(--color-ink-inverse);
    font-style: normal;
    font-weight: 700;
  }
</style>
