---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Card from '../ui/Card.astro';
import Heading from '../ui/Heading.astro';
import BlockHeader from './BlockHeader.astro';
import { Icon } from 'astro-icon/components';
import type { BlockProps } from './types';

export interface ServiceItem {
  title: string;
  body: string;
  href?: string;
  icon?: string;
  /** Small label above the title (e.g. live-site service eyebrows). */
  eyebrow?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** Link text when `href` is set. Defaults to “Learn more”. */
  ctaLabel?: string;
}

interface Props extends BlockProps {
  items: ServiceItem[];
  columns?: 2 | 3 | 4;
}

const {
  background = 'base',
  spacing = 'md',
  align = 'start',
  width = 'page',
  eyebrow,
  title,
  body,
  titleLevel = 2,
  items,
  columns = 3,
} = Astro.props;

// Owns its own grid rather than asking Container to model it.
const columnClass = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
}[columns];
---

<Section background={background} spacing={spacing}>
  <Container width={width} align={align} gap="lg">
    <BlockHeader
      eyebrow={eyebrow}
      title={title}
      body={body}
      level={titleLevel}
      centered={align === 'center'}
    />

    <ul class:list={['grid w-full gap-6', columnClass]}>
      {
        items.map((item) => (
          <Card
            as="li"
            variant="outlined"
            class={item.image ? 'gap-0 overflow-hidden p-0' : undefined}
          >
            {item.image && (
              <Image
                src={item.image}
                alt={item.imageAlt ?? ''}
                widths={[320, 480, 640]}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                loading="lazy"
                class="aspect-24/10 w-full object-cover"
              />
            )}
            <div class:list={['flex flex-col gap-3', item.image && 'p-6']}>
              {item.icon && !item.image && (
                <Icon name={item.icon} class="text-brand-600 size-8" aria-hidden="true" />
              )}
              {item.eyebrow && (
                <p class="text-ink-brand text-xs font-semibold tracking-wide uppercase">
                  {item.eyebrow}
                </p>
              )}
              <Heading level={titleLevel === 2 ? 3 : 4} size="md">
                {item.href && !item.ctaLabel ? (
                  <a href={item.href} class="text-ink-base no-underline hover:underline">
                    {item.title}
                  </a>
                ) : (
                  item.title
                )}
              </Heading>
              <p class="text-ink-muted">{item.body}</p>
              {item.href && item.ctaLabel && (
                <a
                  href={item.href}
                  class="text-brand-700 mt-auto inline-flex min-h-11 items-center text-sm font-semibold no-underline hover:underline"
                >
                  {item.ctaLabel}
                </a>
              )}
            </div>
          </Card>
        ))
      }
    </ul>
  </Container>
</Section>
