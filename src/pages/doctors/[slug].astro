---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Heading from '../../components/ui/Heading.astro';
import Prose from '../../components/ui/Prose.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import MapEmbed from '../../components/blocks/MapEmbed.astro';
import {
  getPublished,
  lastName,
  profileCopy,
  related,
  resolveLocations,
  type Entry,
} from '../../lib/doctors';
import { getPublished as getLocations, type Entry as LocationEntry } from '../../lib/locations';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getPublished();
  const locations = await getLocations();

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      all: entries,
      locations: resolveLocations(entry, locations),
      allLocations: locations,
    },
  }));
};

interface Props {
  entry: Entry;
  all: Entry[];
  locations: LocationEntry[];
  allLocations: LocationEntry[];
}

const { entry, all, locations, allLocations } = Astro.props;
const copy = profileCopy(entry.body);
const Content = copy.structured ? undefined : (await render(entry)).Content;
const colleagues = related(all, entry);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Doctors', href: '/doctors/' },
  { name: entry.data.name, href: `/doctors/${entry.id}/` },
];
const credentialLine = [entry.data.credentials, entry.data.role].filter(Boolean).join(' · ');

/** "Burgaw, NC 28425-5015" → "Burgaw, NC" for the colleague cards. */
function officeCity(doctor: Entry): string | undefined {
  const name = doctor.data.locations?.[0];
  if (!name) return undefined;
  const location = allLocations.find((item) => item.data.name === name);
  const match = location?.data.cityStateZip.match(/^(.+?,\s*[A-Z]{2})\b/);
  return match?.[1] ?? `${name}, NC`;
}

const telHref = (value: string) => {
  const digits = value.replace(/\D/g, '');
  return `tel:+${digits.length === 10 ? `1${digits}` : digits}`;
};
---

<BaseLayout
  title={entry.data.seoTitle}
  description={entry.data.seoDescription}
  breadcrumbs={crumbs}
>
  <Section background="hero" spacing="md">
    <Container gap="sm">
      <nav aria-label="Breadcrumb">
        <ol class="font-heading flex flex-wrap items-center gap-x-2 text-base text-white">
          {
            crumbs.map((crumb, index) => {
              const current = index === crumbs.length - 1;
              return (
                <>
                  {index > 0 && (
                    <li aria-hidden="true" class="font-normal">
                      »
                    </li>
                  )}
                  <li>
                    {current ? (
                      <span aria-current="page">{crumb.name}</span>
                    ) : (
                      <a
                        href={crumb.href}
                        class="font-medium text-white no-underline hover:underline"
                      >
                        {crumb.name}
                      </a>
                    )}
                  </li>
                </>
              );
            })
          }
        </ol>
      </nav>
      <Heading level={1} class="text-ink-inverse">{entry.data.name}</Heading>
    </Container>
  </Section>

  <Section background="base" spacing="md">
    <Container class="lg:flex-row lg:items-start lg:gap-[100px]">
      <div class="flex w-full min-w-0 flex-1 flex-col gap-4">
        <div class="flex w-full flex-col items-start gap-9 sm:flex-row">
          {
            entry.data.photo && (
              <img
                src={entry.data.photo}
                alt=""
                class="aspect-4/5 w-full max-w-[278px] rounded-2xl object-cover object-top sm:w-[278px] sm:shrink-0"
              />
            )
          }
          <div class="flex min-w-0 flex-1 flex-col gap-[18px]">
            <Heading level={2} size="lg">{entry.data.name}</Heading>
            {
              credentialLine && (
                <p class="text-ink-heading font-sans text-base font-black">{credentialLine}</p>
              )
            }
            {
              entry.data.shortBio && (
                <p class="text-ink-base text-base leading-relaxed">{entry.data.shortBio}</p>
              )
            }
            {
              copy.structured && copy.education.length > 0 && (
                <div class="flex flex-col gap-2">
                  <h3 class="text-ink-heading font-sans text-base font-black">Education</h3>
                  <ul class="text-ink-base list-disc space-y-1.5 ps-6 text-base leading-relaxed">
                    {copy.education.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              )
            }
          </div>
        </div>

        {
          copy.structured
            ? copy.about.length > 0 && (
                <div class="flex flex-col gap-4 pt-3">
                  <h2 class="text-ink-heading font-sans text-xl font-black">
                    About Dr {lastName(entry.data.name)}
                  </h2>
                  {copy.about.map((paragraph) => (
                    <p class="text-ink-base text-base leading-relaxed">{paragraph}</p>
                  ))}
                </div>
              )
            : Content && (
                <Prose class="max-w-none">
                  <Content />
                </Prose>
              )
        }
      </div>

      <aside class="flex w-full shrink-0 flex-col gap-5 lg:w-[396px]">
        {
          locations.map((location) => {
            const address = `${location.data.addressLine}, ${location.data.cityStateZip}`;
            return (
              <article class="w-full overflow-hidden rounded-2xl">
                <MapEmbed bare flush height="206px" query={address} />
                <div class="bg-surface-muted flex flex-col gap-4 px-4 py-3.5">
                  <h3 class="font-heading text-[2rem] leading-tight font-bold tracking-tight">
                    <a
                      href={`/locations/${location.id}/`}
                      class="text-ink-heading no-underline hover:underline"
                    >
                      {location.data.name}
                    </a>
                  </h3>
                  <ul class="flex flex-col gap-4">
                    <li class="text-ink-base flex items-start gap-2.5 text-sm">
                      <Icon
                        name="lucide:map-pin"
                        class="mt-0.5 size-4 shrink-0"
                        aria-hidden="true"
                      />
                      <span>
                        {location.data.addressLine}
                        <br />
                        {location.data.cityStateZip}
                      </span>
                    </li>
                    <li class="flex items-start gap-2.5 text-sm">
                      <Icon name="lucide:phone" class="mt-0.5 size-4 shrink-0" aria-hidden="true" />
                      <a href={telHref(location.data.phone)} class="text-ink-base underline">
                        {location.data.phone}
                      </a>
                    </li>
                    {location.data.fax && (
                      <li class="text-ink-base flex items-start gap-2.5 text-sm">
                        <Icon
                          name="lucide:printer"
                          class="mt-0.5 size-4 shrink-0"
                          aria-hidden="true"
                        />
                        <span>{location.data.fax}</span>
                      </li>
                    )}
                    <li class="flex items-start gap-2.5 text-sm">
                      <Icon name="lucide:mail" class="mt-0.5 size-4 shrink-0" aria-hidden="true" />
                      <a
                        href={`mailto:${location.data.email}`}
                        class="text-ink-base break-all underline"
                      >
                        {location.data.email}
                      </a>
                    </li>
                  </ul>
                </div>
              </article>
            );
          })
        }

        <Card variant="navy" hover={false}>
          <Icon name="lucide:wallet" data-slot="icon" aria-hidden="true" />
          <div class="tracking-eyebrow text-xs font-semibold uppercase" data-slot="eyebrow">
            Insurance & Financing
          </div>
          <Heading level={3} size="md">Affordable orthodontic financing</Heading>
          <p class="text-sm">
            We offer flexible payment plans, work with major insurance providers, and partner with
            CareCredit to make treatment affordable.
          </p>
          <a
            href="/insurance/"
            class="mt-auto inline-flex min-h-11 items-center text-sm font-semibold no-underline"
            data-slot="cta"
          >
            Explore Options
          </a>
        </Card>
      </aside>
    </Container>
  </Section>

  {
    colleagues.length > 0 && (
      <Section background="muted" spacing="md">
        <Container gap="lg">
          <Heading level={2} size="lg">
            More of our doctors…
          </Heading>
          <ul class="grid w-full gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {colleagues.map((item) => {
              const city = officeCity(item);
              return (
                <Card as="li" variant="outlined" padded={false} hover={false} class="w-full">
                  <div class="flex h-full w-full flex-1 items-stretch">
                    <div class="relative w-2/5 shrink-0 self-stretch">
                      {item.data.photo ? (
                        <img
                          src={item.data.photo}
                          alt=""
                          loading="lazy"
                          class="absolute inset-0 h-full w-full object-cover object-top"
                        />
                      ) : (
                        <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 bg-neutral-50 px-2 text-center">
                          <Icon
                            name="lucide:user"
                            class="text-ink-muted size-8"
                            aria-hidden="true"
                          />
                          <p class="text-ink-muted text-xs font-medium">Doctor Photo</p>
                        </div>
                      )}
                      <div class="aspect-4/5 w-full" aria-hidden="true" />
                    </div>
                    <div class="flex min-w-0 flex-1 flex-col items-start justify-center gap-3 p-4">
                      <div class="flex flex-col gap-1">
                        <Heading level={3} size="sm" class="text-ink-base">
                          {item.data.name}
                        </Heading>
                        {item.data.role && <p class="text-ink-muted text-sm">{item.data.role}</p>}
                      </div>
                      {city && (
                        <p class="text-ink-muted flex items-center gap-1.5 text-sm">
                          <Icon name="lucide:map-pin" class="size-4 shrink-0" aria-hidden="true" />
                          {city}
                        </p>
                      )}
                      <Button href={`/doctors/${item.id}/`} size="sm">
                        View Doctor
                      </Button>
                    </div>
                  </div>
                </Card>
              );
            })}
          </ul>
        </Container>
      </Section>
    )
  }
</BaseLayout>
