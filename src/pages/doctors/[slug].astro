---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Heading from '../../components/ui/Heading.astro';
import Prose from '../../components/ui/Prose.astro';
import Card from '../../components/ui/Card.astro';
import { getPublished, related, resolveLocations, type Entry } from '../../lib/doctors';
import { getPublished as getLocations, type Entry as LocationEntry } from '../../lib/locations';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getPublished();
  const locations = await getLocations();

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, all: entries, locations: resolveLocations(entry, locations) },
  }));
};

interface Props {
  entry: Entry;
  all: Entry[];
  locations: LocationEntry[];
}

const { entry, all, locations } = Astro.props;
const { Content } = await render(entry);
const colleagues = related(all, entry);
---

<BaseLayout
  title={entry.data.seoTitle}
  description={entry.data.seoDescription}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Doctors', href: '/doctors/' },
    { name: entry.data.name, href: `/doctors/${entry.id}/` },
  ]}
>
  <Section background="muted" spacing="md">
    <Container width="narrow" layout={entry.data.photo ? 'row' : 'stack'} gap="lg">
      {
        entry.data.photo && (
          <img
            src={entry.data.photo}
            alt=""
            class="aspect-4/5 w-full max-w-48 shrink-0 rounded-lg object-cover"
          />
        )
      }
      <div class="flex flex-col gap-2">
        <Heading level={1}>{entry.data.name}</Heading>
        {
          (entry.data.credentials || entry.data.role) && (
            <p class="text-ink-muted text-sm">
              {[entry.data.credentials, entry.data.role].filter(Boolean).join(' · ')}
            </p>
          )
        }
        {entry.data.shortBio && <p class="text-ink-muted text-lg">{entry.data.shortBio}</p>}

        {
          entry.data.specialties && entry.data.specialties.length > 0 && (
            <ul class="flex flex-wrap gap-2">
              {entry.data.specialties.map((specialty) => (
                <li class="bg-brand-50 text-ink-brand rounded-full px-3 py-1 text-xs font-semibold">
                  {specialty}
                </li>
              ))}
            </ul>
          )
        }

        {
          locations.length > 0 && (
            <div class="flex flex-col gap-2">
              <p class="text-ink-muted text-xs font-semibold tracking-wide uppercase">
                Office locations
              </p>
              <ul class="flex flex-col gap-2">
                {locations.map((location) => (
                  <li>
                    <a
                      href={`/locations/${location.id}/`}
                      class="text-ink-brand font-medium no-underline hover:underline"
                    >
                      {location.data.name}
                    </a>
                    <span class="text-ink-muted text-sm"> · {location.data.cityStateZip}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </Container>
  </Section>

  <Section background="base" spacing="md">
    <Container width="narrow">
      <Prose>
        <Content />
      </Prose>
    </Container>
  </Section>

  {
    colleagues.length > 0 && (
      <Section background="muted" spacing="md">
        <Container gap="lg">
          <Heading level={2}>Other doctors</Heading>
          <ul class="grid w-full gap-6 sm:grid-cols-3">
            {colleagues.map((item) => (
              <Card as="li" variant="outlined">
                <Heading level={3} size="sm">
                  <a
                    href={`/doctors/${item.id}/`}
                    class="text-ink-base no-underline hover:underline"
                  >
                    {item.data.name}
                  </a>
                </Heading>
                {item.data.role && <p class="text-ink-muted text-sm">{item.data.role}</p>}
              </Card>
            ))}
          </ul>
        </Container>
      </Section>
    )
  }
</BaseLayout>
