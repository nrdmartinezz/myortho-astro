---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/blocks/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Card from '../../components/ui/Card.astro';
import Heading from '../../components/ui/Heading.astro';
import { bookHref, virtualHref, phoneAction } from '../../config/site';
import { getPublished, type Entry } from '../../lib/locations';

const pageActions = [
  { icon: 'lucide:calendar', label: 'Book a FREE Consult', href: bookHref },
  { icon: 'lucide:laptop', label: 'Virtual Consult', href: virtualHref, variant: 'outline' as const },
  { ...phoneAction, variant: 'outline' as const },
];

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const entries = await getPublished();
  return paginate(entries, { pageSize: 9 });
};

interface Props {
  page: Page<Entry>;
}

const { page } = Astro.props;
---

<BaseLayout
  title="Locations"
  description="14 convenient locations across North Carolina."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Locations', href: '/locations/' },
  ]}
>
  <PageHero
    eyebrow="North Carolina · MyOrthodontist"
    title="Locations"
    body="14 convenient locations across North Carolina."
    actions={pageActions}
  />

  <Section background="base" spacing="md">
    <Container gap="lg">
      <ul class="grid w-full gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          page.data.map((entry) => (
            <Card as="li" variant="outlined">
              <p class="text-ink-muted text-sm">{entry.data.region}</p>
              <Heading level={2} size="md">
                <a
                  href={`/locations/${entry.id}/`}
                  class="text-ink-base no-underline hover:underline"
                >
                  {entry.data.name}
                </a>
              </Heading>
              <p class="text-ink-muted">{entry.data.cityStateZip}</p>
              <p class="text-ink-muted text-sm">{entry.data.hours}</p>
            </Card>
          ))
        }
      </ul>

      {
        (page.url.prev || page.url.next) && (
          <nav class="flex w-full items-center justify-between" aria-label="Pagination">
            {page.url.prev ? (
              <a href={page.url.prev} class="text-ink-brand inline-flex min-h-11 items-center">
                ← Newer
              </a>
            ) : (
              <span />
            )}
            <p class="text-ink-muted text-sm">
              Page {page.currentPage} of {page.lastPage}
            </p>
            {page.url.next ? (
              <a href={page.url.next} class="text-ink-brand inline-flex min-h-11 items-center">
                Older →
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }
    </Container>
  </Section>
</BaseLayout>