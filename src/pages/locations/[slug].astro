---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Heading from '../../components/ui/Heading.astro';
import Prose from '../../components/ui/Prose.astro';
import Card from '../../components/ui/Card.astro';
import MapEmbed from '../../components/blocks/MapEmbed.astro';
import LocationHero, { type LocationDoctor } from '../../components/blocks/LocationHero.astro';
import ServicesGrid from '../../components/blocks/ServicesGrid.astro';
import CTABanner from '../../components/blocks/CTABanner.astro';
import { getPublished, related, type Entry } from '../../lib/locations';
import { atLocation, getPublished as getDoctors } from '../../lib/doctors';
import { getCurrentOffer } from '../../lib/offers';
import { bookHref } from '../../config/site';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getPublished();
  const allDoctors = await getDoctors();

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      all: entries,
      doctors: atLocation(allDoctors, entry.data.name).map((doctor) => ({
        name: doctor.data.name,
        credentials: doctor.data.credentials,
        role: doctor.data.role,
        photo: doctor.data.photo,
        href: `/doctors/${doctor.id}/`,
      })),
    },
  }));
};

interface Props {
  entry: Entry;
  all: Entry[];
  doctors: LocationDoctor[];
}

const { entry, all, doctors } = Astro.props;
const { Content } = await render(entry);
const nearby = related(all, entry);
const offer = await getCurrentOffer();
const hasNotes = Boolean(entry.body?.trim());
const expiresLabel = offer?.data.expires
  ? offer.data.expires.toLocaleDateString('en-US', { month: 'long', day: 'numeric' })
  : undefined;
---

<BaseLayout
  title={entry.data.seoTitle}
  description={entry.data.seoDescription}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Locations', href: '/locations/' },
    { name: entry.data.name, href: `/locations/${entry.id}/` },
  ]}
>
  <LocationHero
    name={entry.data.name}
    region={entry.data.region}
    addressLine={entry.data.addressLine}
    cityStateZip={entry.data.cityStateZip}
    phone={entry.data.phone}
    fax={entry.data.fax}
    email={entry.data.email}
    hours={entry.data.hours}
    doctors={doctors}
  />

  <MapEmbed query={`${entry.data.addressLine}, ${entry.data.cityStateZip}`} />

  {
    hasNotes && (
      <Section background="base" spacing="md">
        <Container width="narrow">
          <Prose>
            <Content />
          </Prose>
        </Container>
      </Section>
    )
  }

  <ServicesGrid
    background={hasNotes ? 'muted' : 'base'}
    columns={2}
    eyebrow="This office"
    title="Insurance & services"
    body="For information about holiday and summer hours please call the office."
    items={[
      {
        icon: 'lucide:shield-check',
        title: 'Insurance & financing',
        body: entry.data.acceptsMedicaid
          ? 'We accept NC Medicaid and most insurance plans, plus CareCredit and in-house financing.'
          : 'We accept most insurance plans, plus CareCredit and in-house financing.',
        href: '/insurance/',
        ctaLabel: 'See insurance options',
      },
      {
        icon: 'lucide:smile',
        title: 'Treatments',
        body: 'Invisalign, braces, Carriere Motion, and the Dental Pain Eraser.',
        href: '/services/',
        ctaLabel: 'View treatments',
      },
    ]}
  />

  {
    offer && (
      <CTABanner
        background="brand"
        eyebrow="Current special"
        title={offer.data.headline}
        body={expiresLabel ? `${offer.data.summary} Offer ends ${expiresLabel}.` : offer.data.summary}
        actions={[
          { icon: 'lucide:calendar', label: 'Book a FREE Consult', href: bookHref },
          { label: 'Learn more', href: '/special-offers/', variant: 'outline' },
        ]}
      />
    )
  }

  {
    nearby.length > 0 && (
      <Section background="muted" spacing="md">
        <Container gap="lg">
          <Heading level={2}>Nearby locations</Heading>
          <ul class="grid w-full gap-6 sm:grid-cols-3">
            {nearby.map((item) => (
              <li>
                <Card
                  as="a"
                  href={`/locations/${item.data.slug ?? item.id}/`}
                  variant="outlined"
                  class="location-card-link text-ink-base h-full no-underline"
                >
                  <Heading level={3} size="sm">
                    {item.data.name}
                  </Heading>
                  <p class="text-ink-muted text-sm">{item.data.cityStateZip}</p>
                </Card>
              </li>
            ))}
          </ul>
        </Container>
      </Section>
    )
  }
</BaseLayout>
