---
import { render } from 'astro:content';
import SubpageLayout from '../../layouts/SubpageLayout.astro';
import Prose from '../../components/ui/Prose.astro';
import { getCurrentOffer } from '../../lib/offers';

const offer = await getCurrentOffer();

if (!offer) {
  throw new Error('No published offer in src/content/offers/.');
}

const { Content } = await render(offer);
const expiresLabel = offer.data.expires
  ? offer.data.expires.toLocaleDateString('en-US', { month: 'long', day: 'numeric' })
  : undefined;
---

<SubpageLayout
  title="Special Offers"
  description="Current promotions on braces and clear aligners — plus a free consultation, always."
  eyebrow="Discounts &amp; Specials"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Resources', href: '/resources/' },
    { name: 'Special Offers', href: '/special-offers/' },
  ]}
>
  <Prose>
    <h2>{offer.data.headline}</h2>
    {expiresLabel && <p><em>Offer ends {expiresLabel}.</em></p>}
    <Content />
  </Prose>
</SubpageLayout>
