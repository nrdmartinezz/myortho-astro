---
import SubpageLayout from '../../layouts/SubpageLayout.astro';
import Prose from '../../components/ui/Prose.astro';
import FeatureSplit from '../../components/blocks/FeatureSplit.astro';
import ServicesGrid from '../../components/blocks/ServicesGrid.astro';
import { bookHref, virtualHref } from '../../config/site';
import virtualConsult from '../../images/foundation/virtual-consult.jpg';
---

<SubpageLayout
  eyebrow="Braces for Adults in North Carolina"
  title="Adult Braces"
  description="You are never too old to have the smile of your dreams. Complimentary in-office or virtual consultations for adult braces across North Carolina."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Treatments', href: '/services/' },
    { name: 'Adult Braces', href: '/braces-for-adults/' },
  ]}
>
  <Prose>
    <h2>Braces for Adults at MyOrthodontist</h2>
    <p>
      At MyOrthodontist, we are of the belief that <strong
        >you are never too old to have the smile of your dreams</strong
      >. In fact, orthodontic trends have shown that more and more adults are turning to orthodontic
      treatment now than ever before. Here at MyOrthodontist, we see a number of adult patients who
      want to uncover their dream smile.
    </p>
    <p>
      Whether you have serious bite problems to fix, a tooth you would like moved, or some crowding
      you would like addressed, our team here at MyOrthodontist would be happy and honored to assist
      you. Schedule your in-office or virtual complimentary consultation today.
    </p>
  </Prose>

  <ServicesGrid
    bare
    columns={2}
    align="start"
    eyebrow="Your options"
    title="Braces are a great option for many adults"
    body="There are two braces options to choose from at MyOrthodontist — traditional metal braces, and a more discreet ceramic alternative."
    items={[
      {
        icon: 'lucide:smile',
        title: 'Metal Braces',
        body: 'Traditional metal braces are probably what you think about when you think “braces.” They remain a proven, effective option for adults who need reliable bite correction.',
        href: '/types-of-braces/',
        ctaLabel: 'Learn more',
      },
      {
        icon: 'lucide:sparkles',
        title: 'Ceramic Braces',
        body: 'Ceramic, or clear braces, are far more discreet than traditional metal braces. They are made out of a tooth-colored ceramic material, allowing them to blend into your teeth.',
        href: '/types-of-braces/',
        ctaLabel: 'Learn more',
      },
    ]}
  />

  <FeatureSplit
    bare
    eyebrow="A streamlined process"
    title="Getting the smile of your dreams has never been so easy"
    body="Here at MyOrthodontist, we have a streamlined braces process that will make you wonder why you waited so long to get orthodontic treatment in the first place. Treatment isn’t like your typical orthodontist — we have carefully selected exceptional team members to assist you on your smile journey."
    image={virtualConsult}
    imageAlt="Adult patient in a virtual orthodontic consultation"
    bullets={[
      'Schedule a complimentary consultation — virtual or at one of our many locations',
      'Our orthodontist curates a totally customized treatment plan based on your specific needs',
      'Start treatment with a team that makes sure you always leave your appointment with a smile',
    ]}
    actions={[
      { label: 'Book a FREE Consult', href: bookHref },
      { label: 'Virtual Consult', href: virtualHref, variant: 'outline' },
    ]}
  />
</SubpageLayout>
