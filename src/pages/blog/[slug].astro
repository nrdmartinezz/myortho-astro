---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Heading from '../../components/ui/Heading.astro';
import Prose from '../../components/ui/Prose.astro';
import Card from '../../components/ui/Card.astro';
import SubpageAside from '../../components/blocks/SubpageAside.astro';
import type { OfficeItem } from '../../components/blocks/OfficeList.astro';
import { getPublished, readingTime, related, hrefFor, imageFor, type Entry } from '../../lib/posts';
import { getPublished as getLocations } from '../../lib/locations';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getPublished();
  const locations = await getLocations();
  const offices = locations.map((location) => ({
    name: location.data.name,
    phone: location.data.phone,
    href: `/locations/${location.data.slug ?? location.id}/`,
  }));

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, all: entries, offices },
  }));
};

interface Props {
  entry: Entry;
  all: Entry[];
  offices: OfficeItem[];
}

const { entry, all, offices } = Astro.props;
const { Content } = await render(entry);
const heroImage = imageFor(entry);

const dateFormat = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' });
const suggestions = related(all, entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  image={heroImage.src}
  publishedTime={entry.data.publishDate.toISOString()}
  modifiedTime={entry.data.updatedDate?.toISOString()}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Blog', href: '/blog/' },
    { name: entry.data.title, href: hrefFor(entry) },
  ]}
>
  <Section background="muted" spacing="md">
    <Container gap="sm">
      <p class="text-ink-muted text-sm">
        <time datetime={entry.data.publishDate.toISOString()}>
          {dateFormat.format(entry.data.publishDate)}
        </time>
        <span> · {readingTime(entry.body)}</span>
        {entry.data.author && <span> · {entry.data.author}</span>}
      </p>
      <Heading level={1}>{entry.data.title}</Heading>
      <p class="text-ink-muted max-w-reading text-lg">{entry.data.description}</p>
    </Container>
  </Section>

  <Section background="base" spacing="md">
    <Container gap="lg" class="lg:flex-row lg:items-start">
      <div class="flex w-full min-w-0 flex-col gap-8 lg:w-2/3">
        <Image
          src={heroImage}
          alt={entry.data.heroImageAlt || entry.data.title}
          widths={[480, 900]}
          sizes="(max-width: 1024px) 100vw, 66vw"
          loading="eager"
          fetchpriority="high"
          class="w-full rounded-lg"
        />
        <Prose>
          <Content />
        </Prose>
      </div>
      <div class="w-full lg:sticky lg:top-24 lg:w-1/3 lg:self-start">
        <SubpageAside offices={offices} />
      </div>
    </Container>
  </Section>

  {
    suggestions.length > 0 && (
      <Section background="muted" spacing="md">
        <Container gap="lg">
          <Heading level={2}>Keep reading</Heading>
          <ul class="grid w-full gap-6 sm:grid-cols-3">
            {suggestions.map((item) => (
              <Card as="li" variant="outlined">
                <Heading level={3} size="sm">
                  <a href={hrefFor(item)} class="text-ink-base no-underline hover:underline">
                    {item.data.title}
                  </a>
                </Heading>
                <p class="text-ink-muted text-sm">{item.data.description}</p>
              </Card>
            ))}
          </ul>
        </Container>
      </Section>
    )
  }
</BaseLayout>
