{
  "name": "myortho-astro",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/build-tokens.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/build-tokens.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "preverify": "node scripts/build-tokens.mjs",
    "verify": "astro check && prettier --check .",
    "format": "prettier --write .",
    "audit:lh": "lhci autorun",
    "audit:a11y": "start-server-and-test preview http://localhost:4321 \"pa11y-ci\"",
    "audit:deps": "node scripts/audit-deps.mjs",
    "audit": "npm run audit:lh && npm run audit:a11y"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.2.8",
    "@iconify-json/lucide": "^1.2.72",
    "@tailwindcss/vite": "^4.1.16",
    "astro": "^7.3.1",
    "astro-icon": "^1.1.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.16"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@lhci/cli": "^0.15.1",
    "pa11y-ci": "^4.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "start-server-and-test": "^2.1.2",
    "style-dictionary": "^5.4.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "sharp": "0.35.3",
    "tmp": "0.2.7",
    "fast-uri": "3.1.6",
    "qs": "6.16.0",
    "uuid": "11.1.1",
    "esbuild": "0.28.1"
  },
  "allowScripts": {
    "@bundled-es-modules/glob@10.4.2": true,
    "esbuild@0.28.1": true,
    "puppeteer@24.43.1": true,
    "sharp@0.35.3": true,
    "style-dictionary@5.5.2": true,
    "fsevents@2.3.3": true
  }
}
